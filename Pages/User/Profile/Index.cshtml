@page 
@model BanSachRazorPages.Pages.User.Profile.IndexModel
@{ ViewData["Title"] = "Thông tin cá nhân"; }
<div class="container page-space"><section class="auth-card"><h1>Thông tin cá nhân</h1><partial name="_Feedback" /><form method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Input.FullName" class="form-label">Họ và tên</label><input asp-for="Input.FullName" type="text" class="form-control"  /><span asp-validation-for="Input.FullName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Phone" class="form-label">Số điện thoại</label><input asp-for="Input.Phone" type="tel" class="form-control"  /><span asp-validation-for="Input.Phone" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Email" class="form-label">Email</label><input asp-for="Input.Email" type="email" class="form-control"  /><span asp-validation-for="Input.Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Address" class="form-label">Địa chỉ</label><textarea asp-for="Input.Address" class="form-control" rows="3"></textarea><span asp-validation-for="Input.Address" class="text-danger"></span></div><button class="btn btn-filter">Lưu thông tin</button><a class="btn btn-link" asp-page="./ChangePassword">Đổi mật khẩu</a></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
