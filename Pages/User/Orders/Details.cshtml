@page "{id:int}"
@model BanSachRazorPages.Pages.User.Orders.DetailsModel
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<div class="container page-space"><a asp-page="./Index">← Danh sách đơn hàng</a><h1 class="mt-3">Đơn hàng #@Model.Order.OrderId</h1><partial name="_Feedback" /><partial name="_OrderInfo" model="Model.Order" />@if (Model.Order.Status == "Pending") { <form class="mt-4" method="post" asp-page-handler="Cancel"><button class="btn btn-outline-danger" onclick="return confirm('Bạn muốn hủy đơn hàng này?')">Hủy đơn hàng</button></form> }</div>
