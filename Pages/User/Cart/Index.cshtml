@page 
@model BanSachRazorPages.Pages.User.Cart.IndexModel
@{ ViewData["Title"] = "Giỏ hàng"; }
<div class="container page-space"><h1>Giỏ hàng của bạn</h1><partial name="_Feedback" />
@if (Model.Items.Count == 0) { <div class="empty-products"><span>🛒</span><h2>Giỏ hàng đang trống</h2><a asp-page="/User/Index" class="btn btn-filter mt-3">Khám phá sách</a></div> }
else { <div class="table-responsive panel mt-4"><table class="table align-middle"><thead><tr><th>Sách</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td><a asp-page="/User/Products/Details" asp-route-id="@item.ProductId">@item.ProductName</a>@if (item.Quantity > item.StockQuantity) { <div class="text-danger small">Chỉ còn @item.StockQuantity cuốn, vui lòng điều chỉnh hoặc xóa.</div> }</td><td>@Display.Money(item.Price)</td><td><form method="post" asp-page-handler="Update" class="d-flex gap-2"><input name="productId" type="hidden" value="@item.ProductId" /><input name="quantity" type="number" class="form-control quantity-input" aria-label="Số lượng @item.ProductName" min="1" value="@item.Quantity" /><button class="btn btn-outline-primary btn-sm">Lưu</button></form></td><td>@Display.Money(item.Total)</td><td><form method="post" asp-page-handler="Remove"><input name="productId" type="hidden" value="@item.ProductId" /><button class="btn btn-outline-danger btn-sm">Xóa</button></form></td></tr> }</tbody></table></div><div class="d-flex justify-content-between gap-3 mt-3"><a asp-page="/User/Index">← Tiếp tục mua sách</a><form method="post" asp-page-handler="Clear"><button class="btn btn-outline-danger">Xóa toàn bộ giỏ</button></form></div><div class="cart-summary"><h2 class="h4">Tổng cộng</h2><strong class="fs-3">@Display.Money(Model.Items.Sum(x => x.Total))</strong><p class="text-muted mt-2">@Model.Items.Sum(x => x.Quantity) cuốn sách</p><a class="btn btn-filter w-100" asp-page="/User/Cart/Checkout">Tiến hành thanh toán</a></div> }</div>
