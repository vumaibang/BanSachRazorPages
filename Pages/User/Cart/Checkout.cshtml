@page 
@model BanSachRazorPages.Pages.User.Cart.CheckoutModel
@{ ViewData["Title"] = "Thanh toán"; }
<div class="container page-space"><h1>Xác nhận đặt hàng</h1><div asp-validation-summary="All" class="text-danger"></div>
@if (Model.Items.Count == 0) { <p>Không có sách để thanh toán.</p><a asp-page="/User/Cart/Index" class="btn btn-filter">Về giỏ hàng</a> }
else { <div class="row g-4 mt-2"><div class="col-lg-7"><section class="panel"><h2 class="h4">Thông tin giao hàng</h2><form method="post" data-submit-once><input asp-for="ProductId" type="hidden" /><input asp-for="Quantity" type="hidden" /><div class="mb-3"><label asp-for="Input.ShippingAddress" class="form-label">Địa chỉ nhận hàng</label><input asp-for="Input.ShippingAddress" type="text" class="form-control"  /><span asp-validation-for="Input.ShippingAddress" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Phone" class="form-label">Số điện thoại</label><input asp-for="Input.Phone" type="tel" class="form-control"  /><span asp-validation-for="Input.Phone" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Note" class="form-label">Ghi chú</label><textarea asp-for="Input.Note" class="form-control" rows="3"></textarea><span asp-validation-for="Input.Note" class="text-danger"></span></div><label asp-for="Input.PaymentMethod" class="form-label">Phương thức thanh toán</label><select asp-for="Input.PaymentMethod" class="form-select mb-3"><option value="COD">Thanh toán khi nhận hàng (COD)</option><option value="BankTransfer">Chuyển khoản ngân hàng</option></select><p class="text-muted small">Nếu chọn chuyển khoản, nhà sách sẽ liên hệ xác nhận và cung cấp thông tin chuyển khoản sau khi nhận đơn.</p><button type="submit" class="btn btn-filter">Xác nhận đặt hàng</button></form></section></div><div class="col-lg-5"><section class="panel"><h2 class="h4">@(Model.ProductId.HasValue ? "Mua ngay" : "Đơn hàng của bạn")</h2>@foreach (var item in Model.Items) { <div class="order-line"><span>@item.ProductName × @item.Quantity</span><strong>@Display.Money(item.Total)</strong></div> }<div class="order-line fs-5"><strong>Tổng cộng</strong><strong>@Display.Money(Model.Items.Sum(x => x.Total))</strong></div><a asp-page="/User/Cart/Index">Quay lại giỏ hàng</a></section></div></div> }</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
