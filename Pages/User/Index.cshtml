@page 
@model BanSachRazorPages.Pages.User.IndexModel
@{ ViewData["Title"] = "Khám phá tri thức"; }
<section class="home-banner"><div class="banner-content"><span class="banner-label">CHÀO MỪNG ĐẾN VỚI NHÀ SÁCH</span><h1>Mở một cuốn sách,<br />mở một thế giới.</h1><p>Khám phá những cuốn sách hay, nuôi dưỡng tâm hồn và cùng bạn viết nên những câu chuyện mới.</p><a href="#sach-moi" class="btn-banner">Khám phá ngay →</a></div><div class="banner-books" aria-hidden="true">📚</div></section>
<div class="container bookstore-container"><partial name="_Feedback" /><section><div class="section-heading"><div><span class="section-subtitle">TÌM CẢM HỨNG MỚI</span><h2>Danh mục sách</h2></div></div><div class="category-list"><a class="category-item @(Model.CategoryId == null ? "category-active" : "")" asp-page="/User/Index">Tất cả sách</a>@foreach (var category in Model.Categories) { <a class="category-item @(Model.CategoryId == category.CategoryId ? "category-active" : "")" asp-page="/User/Index" asp-route-CategoryId="@category.CategoryId" asp-fragment="sach-moi">📖 @category.CategoryName</a> }</div></section>
<section class="book-section" id="sach-moi"><div class="section-heading"><div><span class="section-subtitle">DÀNH RIÊNG CHO BẠN</span><h2>Khám phá sách hay</h2></div><span class="book-count">@Model.Total cuốn sách</span></div>
<form method="get" class="filter-box mb-4"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="Search" class="form-label">Tên sách hoặc tác giả</label><input asp-for="Search" class="form-control" placeholder="Bạn đang tìm cuốn sách nào?" /></div><div class="col-md-2"><label asp-for="CategoryId" class="form-label">Danh mục</label><select asp-for="CategoryId" class="form-select"><option value="">Tất cả</option>@foreach (var c in Model.Categories) { <option value="@c.CategoryId">@c.CategoryName</option> }</select></div><div class="col-md-2"><label asp-for="MinPrice" class="form-label">Giá từ</label><input asp-for="MinPrice" type="number" min="0" class="form-control" /></div><div class="col-md-2"><label asp-for="MaxPrice" class="form-label">Giá đến</label><input asp-for="MaxPrice" type="number" min="0" class="form-control" /></div><div class="col-md-2"><label asp-for="Sort" class="form-label">Sắp xếp</label><select asp-for="Sort" class="form-select"><option value="newest">Mới nhất</option><option value="price-asc">Giá tăng dần</option><option value="price-desc">Giá giảm dần</option></select></div></div><div class="mt-3 d-flex gap-2"><button class="btn btn-filter">Tìm sách</button><a class="btn btn-reset" asp-page="/User/Index">Đặt lại</a></div></form>
@if (Model.Products.Count == 0) { <div class="empty-products"><span>📚</span><h3>Không tìm thấy sách</h3><p>Thử thay đổi từ khóa hoặc điều kiện lọc.</p></div> }
else { <div class="row g-4">@foreach (var book in Model.Products) { <div class="col-6 col-lg-3"><article class="book-card"><a class="book-image" asp-page="/User/Products/Details" asp-route-id="@book.ProductId"><partial name="_BookCover" model="book" /></a><div class="book-info"><span class="book-category">@book.Category.CategoryName</span><h3><a asp-page="/User/Products/Details" asp-route-id="@book.ProductId">@book.ProductName</a></h3><p class="book-author">@(book.Author ?? "Đang cập nhật tác giả")</p><div class="book-bottom"><strong>@Display.Money(book.Price)</strong><span class="@(book.StockQuantity > 0 ? "stock-in" : "stock-out")">@(book.StockQuantity > 0 ? $"Còn {book.StockQuantity} cuốn" : "Hết hàng")</span></div><div class="book-actions"><form method="post" asp-page="/User/Cart/Index" asp-page-handler="Add"><input type="hidden" name="productId" value="@book.ProductId" /><input type="hidden" name="returnUrl" value="@(Request.Path + Request.QueryString)" /><button class="btn btn-outline-primary btn-sm w-100" disabled="@(book.StockQuantity <= 0)">Thêm giỏ</button></form><a class="btn btn-danger btn-sm @(book.StockQuantity <= 0 ? "disabled" : "")" asp-page="/User/Cart/Checkout" asp-route-ProductId="@book.ProductId">Mua ngay</a></div></div></article></div> }</div> }
@if (Model.TotalPages > 1) { <nav class="pagination-row" aria-label="Phân trang">@for (var n = Math.Max(1,Model.PageNumber - 3); n <= Math.Min(Model.TotalPages,Model.PageNumber + 3); n++) { <a class="btn @(n == Model.PageNumber ? "btn-filter" : "btn-outline-secondary")" asp-page="/User/Index" asp-route-Search="@Model.Search" asp-route-CategoryId="@Model.CategoryId" asp-route-MinPrice="@Model.MinPrice" asp-route-MaxPrice="@Model.MaxPrice" asp-route-Sort="@Model.Sort" asp-route-PageNumber="@n" asp-fragment="sach-moi">@n</a> }</nav><p class="text-center text-muted mt-2">Trang @Model.PageNumber / @Model.TotalPages</p> }</section></div>
