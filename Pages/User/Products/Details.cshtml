@page "{id:int}"
@model BanSachRazorPages.Pages.User.Products.DetailsModel
@{ ViewData["Title"] = Model.Product.ProductName; }
<div class="container page-space"><a asp-page="/User/Index">← Tiếp tục khám phá sách</a><partial name="_Feedback" /><div class="row g-4 mt-2"><div class="col-md-5"><div class="product-detail-image"><partial name="_BookCover" model="Model.Product" /></div></div><div class="col-md-7 product-detail-info"><span class="book-category">@Model.Product.Category.CategoryName</span><h1>@Model.Product.ProductName</h1><p>Tác giả: <strong>@Model.Product.Author</strong></p><p>Nhà xuất bản: @Model.Product.Publisher · Năm: @Model.Product.PublishYear</p><p>ISBN: @Model.Product.ISBN</p><div class="product-detail-price">@Display.Money(Model.Product.Price)</div><p>Còn @Model.Product.StockQuantity cuốn</p><p class="product-description">@(Model.Product.Description ?? "Thông tin nội dung sách đang được cập nhật.")</p>
<form method="post" asp-page="/User/Cart/Index" asp-page-handler="Add"><input type="hidden" name="productId" value="@Model.Product.ProductId" /><input type="hidden" name="returnUrl" value="@Request.Path" /><label for="quantity" class="form-label">Số lượng</label><input id="quantity" name="quantity" type="number" class="form-control quantity-input mb-3" value="1" min="1" max="@Model.Product.StockQuantity" /><div class="d-flex flex-wrap gap-2"><button class="btn btn-filter" disabled="@(Model.Product.StockQuantity <= 0)">🛒 Thêm vào giỏ hàng</button><button class="btn btn-danger" asp-page="/User/Cart/Index" asp-page-handler="BuyNow" disabled="@(Model.Product.StockQuantity <= 0)">Mua ngay</button></div></form></div></div></div>
