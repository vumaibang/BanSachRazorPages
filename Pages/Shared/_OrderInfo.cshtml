@model Order
<div class="row g-4"><div class="col-lg-8"><section class="panel"><h2 class="h4">Sách trong đơn</h2><div class="table-responsive"><table class="table"><thead><tr><th>Sách</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>@foreach (var line in Model.OrderDetails) { <tr><td>@line.Product.ProductName</td><td>@Display.Money(line.UnitPrice)</td><td>@line.Quantity</td><td>@Display.Money(line.UnitPrice * line.Quantity)</td></tr> }</tbody></table></div><p class="text-end fs-5">Tổng: <strong>@Display.Money(Model.TotalAmount)</strong></p></section></div><div class="col-lg-4"><section class="panel"><h2 class="h4">Thông tin đơn hàng</h2><dl><dt>Khách hàng</dt><dd>@Model.Customer.FullName</dd><dt>Ngày đặt</dt><dd>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd><dt>Trạng thái</dt><dd><partial name="_Status" model="Model.Status" /></dd><dt>Giao đến</dt><dd>@Model.ShippingAddress</dd><dt>Điện thoại</dt><dd>@Model.Phone</dd><dt>Thanh toán</dt><dd>@Display.Payment(Model.PaymentMethod)</dd><dt>Ghi chú</dt><dd>@(Model.Note ?? "Không có")</dd></dl></section></div></div>
