@page 
@model BanSachRazorPages.Pages.Admin.Customers.IndexModel
@{ ViewData["Title"] = "Quản lý khách hàng"; }
<div class="page-heading"><h1>Quản lý khách hàng</h1><a class="btn btn-primary" asp-page="./Create">+ Thêm khách hàng</a></div>
<form method="get" class="filter-toolbar"><input asp-for="SearchTerm" class="form-control" aria-label="Tìm kiếm" placeholder="Tìm kiếm…" /><select asp-for="StatusFilter" class="form-select" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option value="Active">Hoạt động</option><option value="Inactive">Ngừng hoạt động</option></select><button class="btn btn-primary">Lọc</button><a asp-page="./Index" class="btn btn-outline-secondary">Đặt lại</a></form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Họ tên</th><th>Liên hệ</th><th>Địa chỉ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.FullName</td><td>@item.Phone<div class="text-muted small">@item.Email</div></td><td>@item.Address</td><td>@(item.IsActive ? "Hoạt động" : "Ngừng hoạt động")</td><td class="actions"><a asp-page="./Edit" asp-route-id="@item.CustomerId">Sửa</a><a asp-page="./Delete" asp-route-id="@item.CustomerId" class="text-danger me-3">Xóa</a><form method="post" asp-page-handler="ToggleStatus" asp-route-id="@item.CustomerId" class="d-inline"><button class="btn btn-outline-secondary btn-sm">@(item.IsActive ? "Khóa" : "Mở khóa")</button></form></td></tr> }</tbody></table>@if (Model.Items.Count == 0) { <p>Không có dữ liệu phù hợp.</p> }</div>
@if (Model.TotalPages > 1) { <nav class="pagination-row" aria-label="Phân trang">@for (var n = Math.Max(1,Model.PageNumber-3); n <= Math.Min(Model.TotalPages,Model.PageNumber+3); n++) { <a class="btn @(n == Model.PageNumber ? "btn-primary" : "btn-outline-secondary")" asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-PageNumber="@n" >@n</a> }</nav> }
<p class="text-muted mt-3">@Model.Total mục · Trang @Model.PageNumber / @Model.TotalPages</p>
