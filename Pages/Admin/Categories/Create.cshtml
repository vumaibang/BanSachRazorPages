@page 
@model BanSachRazorPages.Pages.Admin.Categories.CreateModel
@{ ViewData["Title"] = "Thêm danh mục"; }
<h1>Thêm danh mục</h1><section class="panel editor-panel"><form method="post" enctype="multipart/form-data" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Input.CategoryName" class="form-label">Tên danh mục</label><input asp-for="Input.CategoryName" type="text" class="form-control"  /><span asp-validation-for="Input.CategoryName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Description" class="form-label">Mô tả</label><textarea asp-for="Input.Description" class="form-control" rows="3"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div><div class="form-check mb-4"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Đang hoạt động</label></div><button type="submit" class="btn btn-primary">Lưu danh mục</button><a class="btn btn-link" asp-page="./Index">Quay lại</a></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
