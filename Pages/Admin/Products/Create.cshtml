@page 
@model BanSachRazorPages.Pages.Admin.Products.CreateModel
@{ ViewData["Title"] = "Thêm sách"; }
<h1>Thêm sách</h1><section class="panel editor-panel"><form method="post" enctype="multipart/form-data" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Input.ProductName" class="form-label">Tên sách</label><input asp-for="Input.ProductName" type="text" class="form-control"  /><span asp-validation-for="Input.ProductName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.CategoryId" class="form-label">Danh mục</label><select asp-for="Input.CategoryId" class="form-select"><option value="0">Chọn danh mục</option>@foreach (var c in Model.Categories) { <option value="@c.CategoryId">@c.CategoryName@(!c.IsActive ? " (ngừng hoạt động)" : "")</option> }</select><span asp-validation-for="Input.CategoryId" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Author" class="form-label">Tác giả</label><input asp-for="Input.Author" type="text" class="form-control"  /><span asp-validation-for="Input.Author" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Publisher" class="form-label">Nhà xuất bản</label><input asp-for="Input.Publisher" type="text" class="form-control"  /><span asp-validation-for="Input.Publisher" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.PublishYear" class="form-label">Năm xuất bản</label><input asp-for="Input.PublishYear" type="number" class="form-control"  /><span asp-validation-for="Input.PublishYear" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.ISBN" class="form-label">ISBN</label><input asp-for="Input.ISBN" type="text" class="form-control"  /><span asp-validation-for="Input.ISBN" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Price" class="form-label">Giá bán (VNĐ)</label><input asp-for="Input.Price" type="number" class="form-control" step="0.01" min="0.01" /><span asp-validation-for="Input.Price" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.StockQuantity" class="form-label">Số lượng tồn kho</label><input asp-for="Input.StockQuantity" type="number" class="form-control" min="0" /><span asp-validation-for="Input.StockQuantity" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Description" class="form-label">Mô tả</label><textarea asp-for="Input.Description" class="form-control" rows="3"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div><div class="mb-3"><label asp-for="ImageFile" class="form-label">Ảnh bìa (PNG/JPEG/WebP, tối đa 5 MB)</label><input asp-for="ImageFile" type="file" accept="image/png,image/jpeg,image/webp" class="form-control" />@if (!string.IsNullOrEmpty(Model.ImageUrl)) { <img class="cover-preview mt-3" src="@Model.ImageUrl" alt="Ảnh bìa hiện tại" /> }</div><div class="form-check mb-4"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Đang hoạt động</label></div><button type="submit" class="btn btn-primary">Lưu sách</button><a class="btn btn-link" asp-page="./Index">Quay lại</a></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
