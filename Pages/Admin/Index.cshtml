@page 
@model BanSachRazorPages.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Tổng quan"; }
<h1>Tổng quan cửa hàng</h1><p class="text-muted">Theo dõi hoạt động kinh doanh và các đơn hàng mới.</p><div class="row g-3 my-2">
@foreach (var stat in new[] { ("Products", "📚 Sản phẩm", Model.Dashboard.Products), ("Categories", "📂 Danh mục", Model.Dashboard.Categories), ("Customers", "👥 Khách hàng", Model.Dashboard.Customers), ("Orders", "🛒 Đơn hàng", Model.Dashboard.Orders) }) { <div class="col-6 col-xl-3"><a asp-page="@($"/Admin/{stat.Item1}/Index")" class="stat-card"><span>@stat.Item2</span><strong>@stat.Item3</strong></a></div> }</div><div class="panel my-4"><p class="text-muted mb-1">Doanh thu từ đơn hoàn thành</p><strong class="fs-2">@Display.Money(Model.Dashboard.Revenue)</strong></div><section class="panel"><h2 class="h4">Đơn hàng gần đây</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var order in Model.Dashboard.RecentOrders) { <tr><td><a asp-page="/Admin/Orders/Details" asp-route-id="@order.OrderId">#@order.OrderId</a></td><td>@order.Customer.FullName</td><td>@order.OrderDate.ToString("dd/MM/yyyy")</td><td>@Display.Money(order.TotalAmount)</td><td><partial name="_Status" model="order.Status" /></td></tr> }</tbody></table>@if (Model.Dashboard.RecentOrders.Count == 0) { <p>Chưa có đơn hàng.</p> }</div></section>
