@page "{id:int}"
@model BanSachRazorPages.Pages.Admin.Orders.DetailsModel
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<a asp-page="./Index">← Danh sách đơn hàng</a><h1 class="mt-3">Đơn hàng #@Model.Order.OrderId</h1><partial name="_OrderInfo" model="Model.Order" />@if (Model.Order.Status is "Pending" or "Shipping") { <section class="panel mt-4"><h2 class="h4">Cập nhật trạng thái</h2><form method="post" asp-page-handler="UpdateStatus" data-submit-once class="d-flex flex-wrap gap-2"><select name="newStatus" class="form-select filter-select" aria-label="Trạng thái mới" required><option value="">Chọn trạng thái</option>@if (Model.Order.Status == "Pending") { <option value="Shipping">Đang giao</option> } else { <option value="Completed">Hoàn thành</option> }<option value="Cancelled">Hủy đơn hàng</option></select><button type="submit" class="btn btn-primary">Cập nhật</button></form><p class="text-muted mt-3 mb-0">Hủy đơn sẽ hoàn lại số lượng sách vào kho.</p></section> }
