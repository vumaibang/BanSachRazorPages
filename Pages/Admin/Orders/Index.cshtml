@page 
@model BanSachRazorPages.Pages.Admin.Orders.IndexModel
@{ ViewData["Title"] = "Quản lý đơn hàng"; }
<h1>Quản lý đơn hàng</h1><form method="get" class="filter-toolbar"><input asp-for="SearchTerm" class="form-control" aria-label="Tìm đơn hàng" placeholder="Mã đơn, tên hoặc điện thoại…" /><select asp-for="Status" class="form-select" aria-label="Trạng thái đơn hàng"><option value="">Tất cả trạng thái</option>@foreach (var status in new[] { "Pending", "Shipping", "Completed", "Cancelled" }) { <option value="@status">@Display.Status(status)</option> }</select><button class="btn btn-primary">Lọc</button></form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var order in Model.Items) { <tr><td>#@order.OrderId</td><td>@order.Customer.FullName</td><td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td><td>@Display.Money(order.TotalAmount)</td><td><partial name="_Status" model="order.Status" /></td><td><a asp-page="./Details" asp-route-id="@order.OrderId">Chi tiết</a></td></tr> }</tbody></table>@if (Model.Items.Count == 0) { <p>Không có đơn hàng phù hợp.</p> }</div>
@if (Model.TotalPages > 1) { <nav class="pagination-row">@for (var n = Math.Max(1,Model.PageNumber-3); n <= Math.Min(Model.TotalPages,Model.PageNumber+3); n++) { <a class="btn @(n == Model.PageNumber ? "btn-primary" : "btn-outline-secondary")" asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-Status="@Model.Status" asp-route-PageNumber="@n">@n</a> }</nav> }
