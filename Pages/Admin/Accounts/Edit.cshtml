@page "{id:int}"
@model BanSachRazorPages.Pages.Admin.Accounts.EditModel
@{ ViewData["Title"] = "Cập nhật tài khoản"; }
<h1>Cập nhật tài khoản</h1><section class="panel editor-panel"><form method="post" enctype="multipart/form-data" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Input.Username" class="form-label">Tên đăng nhập</label><input asp-for="Input.Username" type="text" class="form-control"  /><span asp-validation-for="Input.Username" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Password" class="form-label">Mật khẩu mới (để trống khi sửa nếu giữ nguyên)</label><input asp-for="Input.Password" type="password" class="form-control"  /><span asp-validation-for="Input.Password" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Role" class="form-label">Vai trò</label><select asp-for="Input.Role" class="form-select"><option value="Customer">Khách hàng</option><option value="Admin">Admin</option></select></div><div class="form-check mb-4"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Đang hoạt động</label></div><button type="submit" class="btn btn-primary">Lưu tài khoản</button><a class="btn btn-link" asp-page="./Index">Quay lại</a></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
