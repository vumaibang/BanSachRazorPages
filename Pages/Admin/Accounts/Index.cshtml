@page 
@model BanSachRazorPages.Pages.Admin.Accounts.IndexModel
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<div class="page-heading"><h1>Quản lý tài khoản</h1><a class="btn btn-primary" asp-page="./Create">+ Thêm tài khoản</a></div>
<form method="get" class="filter-toolbar"><input asp-for="SearchTerm" class="form-control" aria-label="Tìm kiếm" placeholder="Tìm kiếm…" /><select asp-for="RoleFilter" class="form-select" aria-label="Vai trò"><option value="">Tất cả vai trò</option><option value="Admin">Admin</option><option value="Customer">Khách hàng</option></select><select asp-for="StatusFilter" class="form-select" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option value="Active">Hoạt động</option><option value="Inactive">Ngừng hoạt động</option></select><button class="btn btn-primary">Lọc</button><a asp-page="./Index" class="btn btn-outline-secondary">Đặt lại</a></form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Tên đăng nhập</th><th>Vai trò</th><th>Ngày tạo</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.Username</td><td>@(item.Role == "Admin" ? "Admin" : "Khách hàng")</td><td>@item.CreatedAt.ToString("dd/MM/yyyy")</td><td>@(item.IsActive ? "Hoạt động" : "Ngừng hoạt động")</td><td class="actions"><a asp-page="./Edit" asp-route-id="@item.AccountId">Sửa</a><a asp-page="./Delete" asp-route-id="@item.AccountId" class="text-danger me-3">Xóa</a><form method="post" asp-page-handler="ToggleStatus" asp-route-id="@item.AccountId" class="d-inline"><button class="btn btn-outline-secondary btn-sm">@(item.IsActive ? "Khóa" : "Mở khóa")</button></form></td></tr> }</tbody></table>@if (Model.Items.Count == 0) { <p>Không có dữ liệu phù hợp.</p> }</div>
@if (Model.TotalPages > 1) { <nav class="pagination-row" aria-label="Phân trang">@for (var n = Math.Max(1,Model.PageNumber-3); n <= Math.Min(Model.TotalPages,Model.PageNumber+3); n++) { <a class="btn @(n == Model.PageNumber ? "btn-primary" : "btn-outline-secondary")" asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter" asp-route-PageNumber="@n"  asp-route-RoleFilter="@Model.RoleFilter">@n</a> }</nav> }
<p class="text-muted mt-3">@Model.Total mục · Trang @Model.PageNumber / @Model.TotalPages</p>
